{
  "name": "prek-autoupdate",
  "version": "2.1.0",
  "private": true,
  "description": "GitHub Action that opens and maintains prek auto-update pull requests",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup --config",
    "check:dist": "npm run build && git diff --exit-code -- dist/index.js",
    "format": "prek run prettier-write --stage manual",
    "format:check": "prek run prettier-check --stage manual",
    "lint": "prek run eslint-all --stage manual",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/http-client": "^4.0.1",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.12.0",
    "jiti": "^2.0.0",
    "prettier": "^3.9.9",
    "rollup": "^4.63.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.12"
  },
  "allowScripts": {
    "fsevents": true
  }
}
