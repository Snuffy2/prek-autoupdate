{
  "name": "prek-autoupdate",
  "version": "2.0.0",
  "private": true,
  "description": "GitHub Action that opens and maintains prek auto-update pull requests",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup --config",
    "check:dist": "npm run build && git diff --exit-code -- dist/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"*.config.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/http-client": "^4.0.1",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.9.0",
    "jiti": "^2.0.0",
    "prettier": "^3.0.0",
    "rollup": "^4.62.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.0.0",
    "yaml": "^2.0.0"
  }
}
